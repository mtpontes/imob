# Variaveis de ambiente do frontend ImobApp
# Copie este arquivo para .env e preencha com os valores reais.
# Os valores sao obtidos apos executar o deploy SAM na AWS.
# Execute: aws cloudformation describe-stacks --stack-name <seu-stack> --query "Stacks[0].Outputs"

NG_APP_COGNITO_USER_POOL_ID=
NG_APP_COGNITO_CLIENT_ID=
NG_APP_COGNITO_DOMAIN=
